<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <servers>
    <server>
      <id>nexus-xcasit</id>
      <username>zhangtianbin</username>
      <password>ZTB980923</password>
    </server>
    <server>
      <id>archetype</id>
      <username>zhangtianbin</username>
      <password>ZTB980923</password>
    </server>
  </servers>

  <localRepository>E:\ProgramData\Maven\Repository</localRepository>

  <mirrors>
    <mirror>
      <id>central</id>
      <mirrorOf>central</mirrorOf>
      <name>nexus xcasit</name>
      <url>http://nexus.xcasit.cn/repository/maven-all-proxy/</url>
    </mirror>
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>!*</mirrorOf>
      <url>http://0.0.0.0/</url>
    </mirror>
  </mirrors>

  <profiles>
    <!-- 全局JDK1.8配置 -->
    <profile>
      <id>jdk-1.8</id>
      <activation>
        <jdk>1.8</jdk>
      </activation>
      <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <maven.compiler.compilerVersion>1.8</maven.compiler.compilerVersion>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
      </properties>
    </profile>
    <!-- 全局JDK11配置 -->
    <profile>
      <id>jdk-11</id>
      <activation>
        <jdk>11</jdk>
      </activation>
      <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <maven.compiler.compilerVersion>11</maven.compiler.compilerVersion>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
      </properties>
    </profile>
    <!-- 全局JDK17配置 -->
    <profile>
      <id>jdk-17</id>
      <activation>
        <jdk>17</jdk>
      </activation>
      <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.compilerVersion>17</maven.compiler.compilerVersion>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
      </properties>
    </profile>
    <!-- 全局JDK21配置 -->
    <profile>
      <id>jdk-21</id>
      <activation>
        <jdk>21</jdk>
      </activation>
      <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.compilerVersion>21</maven.compiler.compilerVersion>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
      </properties>
    </profile>
    <!-- 全局JDK25配置 -->
    <profile>
      <id>jdk-25</id>
      <activation>
        <jdk>25</jdk>
      </activation>
      <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.compilerVersion>25</maven.compiler.compilerVersion>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
      </properties>
    </profile>
    <!-- 私服配置 -->
    <profile>
      <id>nexus-xcasit</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <repo.id>nexus-xcasit</repo.id>
        <repo.releases.url>http://nexus.xcasit.cn/repository/maven-releases/</repo.releases.url>
        <repo.snapshots.url>http://nexus.xcasit.cn/repository/maven-snapshots/</repo.snapshots.url>
        <aether.connector.http.preemptiveAuth.nexus-xcasit>true</aether.connector.http.preemptiveAuth.nexus-xcasit>
      </properties>
      <repositories>
        <repository>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>always</updatePolicy>
          </snapshots>
          <id>nexus-xcasit</id>
          <name>nexus xcasit</name>
          <url>http://nexus.xcasit.cn/repository/maven-all-hosted/</url>
        </repository>
        <repository>
          <id>archetype</id>
          <url>http://nexus.xcasit.cn/repository/maven-all-hosted/</url>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <!-- Resolver transport properties are only read from explicitly active profiles. -->
  <activeProfiles>
    <activeProfile>nexus-xcasit</activeProfile>
  </activeProfiles>
</settings>